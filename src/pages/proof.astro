---
import Base from "../layouts/Base.astro";
import { proof, timeline } from "../data/profile";
---

<Base
  title="proof of work / singu"
  description="co-organized the prediction markets community hub at devcon 8 in mumbai, technical lead at programming club iit kanpur, and two summer of bitcoin proposal rounds."
>
  <h1>proof of work</h1>

  <h2>wins</h2>
  <ul>
    {proof.map((row) => <li>{row.label} &mdash; {row.value}</li>)}
  </ul>

  <h2>what i've been doing</h2>
  <p class="small">newest first.</p>

  {
    timeline.map((t) => (
      <>
        <h3>
          {t.title}
          {t.where && <> @ {t.where}</>}
        </h3>
        <p>
          <i>{t.when}</i>
          {t.upcoming && <b> (upcoming)</b>}
        </p>
        <p>{t.body}</p>
        {t.links && (
          <p>
            {t.links.map((l) => (
              <>
                [<a href={l.href} rel="noopener noreferrer">{l.label}</a>]{" "}
              </>
            ))}
          </p>
        )}
      </>
    ))
  }
</Base>
