---
import Base from "../layouts/Base.astro";
import { humanIntro, humanBlocks, humanCoda } from "../data/profile";
---

<Base
  title="human / singu"
  description="rick and morty, invincible, undertale, tolkien's legendarium, the strokes, lawn tennis, and once genuinely planning to be a dinosaur."
>
  <h1>the human part</h1>
  <p><i>{humanIntro}</i></p>

  {
    humanBlocks.map((block) => (
      <>
        <h2>{block.key}</h2>
        <p>{block.body}</p>
      </>
    ))
  }

  <p>{humanCoda}</p>
</Base>
