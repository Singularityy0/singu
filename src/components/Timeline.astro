---
import Prompt from "./Prompt.astro";
import { timeline } from "../data/profile";
---

<section id="proof" class="mx-auto max-w-5xl px-5 pt-16 pb-16 sm:px-8 sm:pt-24 sm:pb-20">
  <Prompt command="git log --ecosystem" />

  <ol class="mt-8">
    {
      timeline.map((entry) => (
        <li class="grid gap-y-2 sm:grid-cols-[9.5rem_1fr] sm:gap-x-7">
          <p class="tabular pt-px font-mono text-xs text-dim">{entry.when}</p>

          <div class="relative border-l border-rule pb-9 pl-7">
            <span
              class:list={[
                "absolute top-[0.45rem] -left-[3.5px] size-[7px] rounded-full",
                entry.upcoming ? "bg-bid" : "bg-rule",
              ]}
              aria-hidden="true"
            />

            <h2 class="font-mono text-[0.9375rem] leading-snug font-medium text-text">
              {entry.title}
              {entry.where && <span class="text-dim"> at {entry.where}</span>}
            </h2>

            {entry.upcoming && <p class="mt-1 font-mono text-xs text-bid">upcoming</p>}

            <p class="mt-2 max-w-[70ch] text-[0.9375rem] leading-[1.6] text-text/70">{entry.body}</p>

            {
              entry.links && (
                <div class="mt-3 flex flex-wrap gap-4 font-mono text-xs">
                  {entry.links.map((link) => (
                    <a
                      href={link.href}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="text-bid transition-colors hover:text-text"
                    >
                      [ {link.label} ]
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </li>
      ))
    }
  </ol>
</section>
