---
import Prompt from "./Prompt.astro";
import { builds } from "../data/profile";

const featured = builds.filter((b) => b.featured);
const rest = builds.filter((b) => !b.featured);
const ordered = [...featured, ...rest];
---

<section id="builds" class="mx-auto max-w-5xl px-5 pt-16 pb-16 sm:px-8 sm:pt-24 sm:pb-20">
  <Prompt command="ls builds/" />

  <!-- One bordered block, hairline gaps between cells: a table of positions, not a row of cards. -->
  <div class="mt-7 grid gap-px border border-rule bg-rule sm:grid-cols-2">
    {
      ordered.map((build) => (
        <article
          class:list={[
            "flex flex-col bg-ink p-6 sm:p-7",
            build.featured && "sm:col-span-2",
          ]}
        >
          <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2
              class:list={[
                "font-mono font-medium tracking-tight text-bid",
                build.featured ? "text-xl sm:text-2xl" : "text-lg",
              ]}
            >
              {build.name}
            </h2>
            {build.award && <p class="font-mono text-xs text-ask">{build.award}</p>}
            {build.status && <p class="font-mono text-xs text-bid">{build.status}</p>}
          </header>

          <p
            class:list={[
              "mt-3 max-w-[60ch] font-medium text-text",
              build.featured ? "text-lg leading-snug" : "text-[0.9375rem] leading-snug",
            ]}
          >
            {build.tagline}
          </p>

          <p class="mt-3 max-w-[70ch] text-[0.9375rem] leading-[1.6] text-text/70">{build.body}</p>

          {build.role && <p class="mt-4 font-mono text-xs text-dim">{build.role}</p>}

          <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-dim">
            {build.stack.map((tech) => <li>{tech}</li>)}
          </ul>

          <div class="mt-5 flex flex-wrap items-center gap-4 font-mono text-xs">
            {
              build.links?.map((link) => (
                <a
                  href={link.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-bid transition-colors hover:text-text"
                >
                  [ {link.label} ]
                </a>
              ))
            }
            {build.closedSource && <span class="text-dim">[ closed source ]</span>}
          </div>
        </article>
      ))
    }
  </div>
</section>
