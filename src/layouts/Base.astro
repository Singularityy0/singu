---
import "../styles/global.css";
import Prompt from "../components/Prompt.astro";
import { nav, shell } from "../data/profile";

interface Props {
  title: string;
  description: string;
  /** Screen-reader h1 for routes whose design has no visible page title. */
  heading?: string;
}

const { title, description, heading } = Astro.props;

/** Normalised so "/builds" and "/builds/" both mark the same link active. */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>

  <body class="bg-ink text-text font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-panel focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-bid"
    >
      Skip to content
    </a>

    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-4 sm:px-8">
        <a
          href="/"
          aria-current={path === "/" ? "page" : undefined}
          class="font-mono text-sm font-medium tracking-tight text-text"
        >
          {shell.user}<span class="text-bid">@</span>{shell.host}
        </a>

        <nav aria-label="Sections">
          <ul class="flex gap-5 font-mono text-sm">
            {
              nav.map((item) => {
                const active = path === item.href;
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "transition-colors",
                        active ? "text-bid" : "text-dim hover:text-text",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      {heading && <h1 class="sr-only">{heading}</h1>}
      <slot />
    </main>

    <!-- Every view is one command and its output, so every view ends on the cursor. -->
    <div class="mx-auto max-w-5xl px-5 pb-20 sm:px-8 sm:pb-28">
      <Prompt command="" cursor />
    </div>
  </body>
</html>
