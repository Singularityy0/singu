---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** false on the home page, which has the big wordmark instead */
  backLink?: boolean;
}

const { title, description, backLink = true } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site);
const updated = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title="singu's blog" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      try {
        if (localStorage.getItem("lights") === "off") document.documentElement.dataset.theme = "dark";
      } catch (e) {}
    </script>
  </head>

  <body>
    {backLink && <p><a href="/">&larr; home</a></p>}

    <slot />

    <hr />
    <p class="small">
      made by hand (mostly). last updated {updated}.
      <a href="#" id="lights">lights off</a>
    </p>

    <script is:inline>
      (function () {
        var a = document.getElementById("lights");
        var root = document.documentElement;
        function label() {
          a.textContent = root.dataset.theme === "dark" ? "lights on" : "lights off";
        }
        label();
        a.addEventListener("click", function (e) {
          e.preventDefault();
          var dark = root.dataset.theme !== "dark";
          if (dark) root.dataset.theme = "dark";
          else delete root.dataset.theme;
          try { localStorage.setItem("lights", dark ? "off" : "on"); } catch (err) {}
          label();
        });
      })();
    </script>
  </body>
</html>
